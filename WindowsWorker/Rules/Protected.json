{
  "Version": "2.1.5",
  "Description": "Protected Zone — never kill, delete, format, or auto-upgrade these targets",
  "Processes": [
    "Pi Desktop",
    "PiDesktop",
    "Pi Network",
    "PiNetwork",
    "PiNode",
    "Pi Node",
    "PiNodeMonitorLive",
    "DataLive",
    "DataLive_HttpApi",
    "Pi_Node_Telegram_Controller",
    "pinode-telegram-controller",
    "Controller",
    "stellar-core",
    "stellar_core",
    "Docker Desktop",
    "DockerDesktop",
    "com.docker.backend",
    "com.docker.proxy",
    "com.docker.service",
    "dockerd",
    "containerd",
    "containerd-shim",
    "docker-proxy",
    "vpnkit",
    "wsl",
    "wslhost",
    "wslservice",
    "vmmem",
    "vmmemWSL",
    "LxssManager",
    "LxssManagerUser",
    "System",
    "System Idle Process",
    "Registry",
    "smss",
    "csrss",
    "wininit",
    "services",
    "lsass",
    "svchost",
    "winlogon",
    "dwm",
    "explorer",
    "conhost",
    "RuntimeBroker"
  ],
  "Paths": [
    "C:\\ProgramData\\Docker",
    "%LOCALAPPDATA%\\Docker",
    "%USERPROFILE%\\.docker",
    "*\\stellar*",
    "*\\pi-node*",
    "*\\Pi Network*",
    "*\\PiNode*",
    "*\\PiNodeSpider\\Data\\*",
    "*\\PiNodeSpider\\Rules\\*"
  ],
  "Policies": {
    "NeverDelete": true,
    "NeverFormat": true,
    "NeverOverwriteConfigWithoutBackup": true,
    "NeverTouchBIOS": true,
    "NeverAutoUpgradeEXTREME": true,
    "NeverKillProtectedProcess": true,
    "NeverDisableWindowsFirewallEntirely": true
  },
  "Notes": "AI and AUTO modes cannot bypass this zone. EXTREME actions require explicit user approval only."
}
